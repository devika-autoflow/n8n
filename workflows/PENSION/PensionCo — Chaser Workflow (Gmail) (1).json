      "id": "dbf101ed-debb-4a70-aaea-72353203485f",
      "name": "📋 BEST — Get All Pended Cases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2544,
        -112
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst cases = response.cases ?? [];\n\nif (cases.length === 0) {\n  return [{ json: { no_pending_cases: true, message: 'No pended cases found' } }];\n}\n\nreturn cases.map(c => ({ json: c }));"
      },
      "id": "52fc63e2-24b0-4f2a-acbd-ad532718611c",
      "name": "⚙️ Split — Cases Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2240,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filter cases where chaser is due (10+ days since last chaser)\nconst cases = $input.all();\n\nconst due = cases.filter(item => {\n  const c = item.json;\n\n  // Skip if no sender email\n  if (!c.sender_email && !c.member_nino) return false;\n\n  const lastChaser = c.last_chaser_date ? new Date(c.last_chaser_date) : null;\n  const pendedDate = c.pended_date ? new Date(c.pended_date) : null;\n  const reference  = lastChaser ?? pendedDate;\n\n  if (!reference) return false;\n\n  const daysSince = Math.floor((new Date() - reference) / 86400000);\n\n  // Send chaser if 10+ days since last contact\n  return daysSince >= 10;\n});\n\nif (due.length === 0) {\n  return [{ json: { no_cases_due: true, message: 'No chasers due today' } }];\n}\n\nreturn due;"
      },
      "id": "74ca9d77-f64f-4d1a-ab43-9ad0804e5a0f",
      "name": "⚙️ Code — Filter Cases Due for Chaser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1568,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n\n  const c = item.json;\n\n  const daysSinceChaser = c.last_chaser_date\n    ? Math.floor((new Date() - new Date(c.last_chaser_date)) / 86400000)\n    : 999;\n\n  const chaserCount = c.chaser_count ?? 0;\n\n  const isEscalation = chaserCount >= 2;\n\n  const subject = isEscalation\n    ? `URGENT - Action Required - Case ${c.case_id} - Final Reminder`\n    : `Reminder - Action Required - Case ${c.case_id}`;\n\n  const pendedReasonText = {\n    ADDRESS_MISMATCH: 'the address you provided does not match our records',\n    AWAITING_ADDRESS_PROOF: 'we are awaiting proof of your current address',\n    MEMBER_NOT_FOUND: 'we were unable to locate your membership record',\n    LOA_INVALID: 'a valid Letter of Authority was not provided',\n    IDENTITY_MISMATCH: 'some of your personal details do not match our records',\n  }[c.pended_reason] ?? 'we require additional information to proceed';\n\n  const body = `PensionCo Administration\nDate: ${new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}\n\nDear ${c.member_name},\n\nRe: Pension Enquiry - Case Reference ${c.case_id}${isEscalation ? ' - URGENT FINAL REMINDER' : ' - Reminder'}\n\nWe are writing regarding your pension enquiry which remains on hold because ${pendedReasonText}.\n\nYour case was opened on ${c.pended_date ? new Date(c.pended_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'a recent date'} and we have not yet received the required information.\n\n${isEscalation\n  ? 'This is your final reminder. If we do not receive the required information within 5 working days, your case will be closed and you will need to resubmit your enquiry.'\n  : 'Please respond at your earliest convenience to allow us to continue processing your request.'\n}\n\nWhat we need from you:\n\n${c.pended_reason === 'ADDRESS_MISMATCH' || c.pended_reason === 'AWAITING_ADDRESS_PROOF'\n  ? '- Proof of your current address (utility bill or bank statement dated within 3 months)'\n  : c.pended_reason === 'LOA_INVALID'\n  ? '- A current signed Letter of Authority dated within the last 12 months'\n  : c.pended_reason === 'IDENTITY_MISMATCH'\n  ? '- Confirmation of your full name, National Insurance number, date of birth, and current address'\n  : '- Please contact us to discuss what information is required'\n}\n\nPlease reply to this email quoting your case reference ${c.case_id}.\n\nYours sincerely,\nPensionCo Administration\nCase Reference: ${c.case_id}\nChaser Number: ${chaserCount + 1}`;\n\n  return {\n    json: {\n      ...c,\n      chaser_subject: subject,\n      chaser_body: body,\n      days_since_chaser: daysSinceChaser,\n      chaser_count: chaserCount,\n      is_escalation: isEscalation,\n      new_chaser_count: chaserCount + 1\n    }\n  };\n\n});"
      },
