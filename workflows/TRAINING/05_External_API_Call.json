    {
      "parameters": {
        "jsCode": "// Turn the raw postcodes.io reply into a tidy result\nconst res = $input.first().json;\n\nif (res.status !== 200) {\n  return [{ json: { valid: false, error: res.error || 'Lookup failed' } }];\n}\n\nconst r = res.result;\nreturn [{\n  json: {\n    valid: true,\n    postcode: r.postcode,\n    country: r.country,\n    region: r.region,\n    district: r.admin_district,\n    latitude: r.latitude,\n    longitude: r.longitude,\n    map_link: `https://www.google.com/maps?q=${r.latitude},${r.longitude}`\n  }\n}];"
      },
