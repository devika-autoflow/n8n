        "jsCode": "const rec = $('Build Denormalized Course Record').item.json;\n\nfunction normalizeDate(s) {\n  if (!s) return null;\n  const d = new Date(s);\n  if (isNaN(d.getTime())) return null;\n  return d.toISOString();\n}\n\nconst rows = (rec.latest_news || []).map(n => ({\n  course_id: rec.course_id,\n  headline: n.headline,\n  summary: n.summary,\n  url: n.url,\n  published_at: normalizeDate(n.published_date || n.published_at)\n}));\nreturn [{ json: { news: rows } }];"
