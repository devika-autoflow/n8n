    },
    {
      "parameters": {
        "jsCode": "const rec = $('Build Denormalized Course Record').item.json;\nconst rows = [];\n(rec.government_colleges || []).forEach(c => rows.push({ course_id: rec.course_id, name: c.name, type: 'government', city: c.city || null, fees_annual: c.fees_annual_inr || c.fees_annual || null }));\n(rec.private_colleges || []).forEach(c => rows.push({ course_id: rec.course_id, name: c.name, type: 'private', city: c.city || null, fees_annual: c.fees_annual_inr || c.fees_annual || null }));\nreturn [{ json: { course_id: rec.course_id, colleges: rows } }];"
      },
