    {
      "parameters": {
        "jsCode": "const courseName = $('Mode = monthly_refresh?').item.json.course_name;\nconst rows = $input.all().map(i => i.json);\nconst row = rows[0];\nif (!row || !row.facts) {\n  return [{ json: { skip: true, reason: 'No verified course_facts found for ' + courseName } }];\n}\nconst facts = row.facts;\nfunction val(key) { return facts[key] ? facts[key].value : null; }\n\nreturn [{\n  json: {\n    course_id: row.course_id,\n    course_name: courseName,\n    description: val('description'),\n    eligibility: val('eligibility'),\n    duration: val('duration'),\n    entrance_exams: val('entrance_exams') || [],\n    emerging_trends: val('emerging_trends'),\n    future_scope: val('future_scope'),\n    career_path: val('career_path'),\n    abroad_opportunities: val('abroad_opportunities'),\n    scholarships: val('scholarships'),\n    government_colleges: val('government_colleges_top3') || [],\n    private_colleges: val('private_colleges_top3') || [],\n    average_salary: val('average_salary_inr'),\n    highest_salary: val('highest_salary_inr'),\n    placement_percent: val('placement_percent'),\n    recruiters: val('recruiters_top5') || [],\n    industry_demand: val('industry_demand'),\n    faq: val('faqs') || [],\n    latest_news: val('news') || [],\n    confidence_score: row.overall_confidence || 0,\n    review_status: (row.overall_confidence || 0) >= 0.8 ? 'verified' : 'flagged'\n  }\n}];\n"
      },
      "id": "w6n-buildrecord",
      "name": "Build Denormalized Course Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
