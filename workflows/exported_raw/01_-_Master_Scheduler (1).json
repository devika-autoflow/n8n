    {
      "parameters": {
        "jsCode": "const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));\nconst dayOfWeek = now.getDay(); // 0=Sun ... 1=Mon\nconst dayOfMonth = now.getDate();\nconst month = now.getMonth() + 1; // 1-12\nconst isMonday = dayOfWeek === 1;\nconst isFirstOfMonth = dayOfMonth === 1;\nconst isQuarterStart = isFirstOfMonth && [1,4,7,10].includes(month);\n\nreturn [{\n  json: {\n    runDate: now.toISOString(),\n    isMonday,\n    isFirstOfMonth,\n    isQuarterStart\n  }\n}];"
      },
