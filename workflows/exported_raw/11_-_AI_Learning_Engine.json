    {
      "parameters": {
        "jsCode": "const dim = $input.first().json;\nconst prompt = `You are a content strategist analyzing performance data for an Indian career-guidance content channel.\\n\\nDimension: ${dim.insight_type}\\nMetric: ${dim.metric_name}\\nTop groups (best to worst, up to 5): ${JSON.stringify(dim.data)}\\n\\nIf there is not enough data (fewer than 3 groups, or all groups have very few samples), say so honestly with low confidence rather than inventing a pattern.\\n\\nReturn ONLY valid JSON: { \"finding\": \"1-2 sentence plain-English description of the pattern\", \"confidence\": 0.0-1.0, \"recommended_change\": \"specific, actionable change to make, or null if not confident enough to act\" }`;\nreturn [{ json: { ...dim, prompt } }];"
      },
