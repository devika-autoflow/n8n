    {
      "parameters": {
        "jsCode": "const dim = $('Build Finding Prompt').item.json;\nconst resp = $json;\nlet text = (resp.output || '').trim().replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(text); } catch (e) { parsed = { finding: 'Could not parse model output', confidence: 0, recommended_change: null }; }\n\nreturn [{ json: {\n  insight_type: dim.insight_type,\n  template_key: dim.template_key,\n  finding: parsed.finding,\n  confidence: typeof parsed.confidence === 'number' ? parsed.confidence : 0,\n  recommended_change: parsed.recommended_change || null,\n  supporting_data: dim.data\n} }];\n"
      },
