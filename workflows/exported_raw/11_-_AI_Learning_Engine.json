    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(function(i) { return i.json; });\n\nfunction avg(arr) { return arr.length ? arr.reduce((a,b)=>a+b,0) / arr.length : 0; }\nfunction topGroup(groups) {\n  const entries = Object.entries(groups).map(([k, v]) => ({ key: k, avg_metric: avg(v), n: v.length }));\n  entries.sort((a, b) => b.avg_metric - a.avg_metric);\n  return entries.slice(0, 5);\n}\n\nconst hookGroups = {}, ctaGroups = {}, durationGroups = {}, variantGroups = {}, platformGroups = {}, hourGroups = {};\n\nrows.forEach(r => {\n  const pt = r.publish_targets;\n  if (!pt) return;\n  const ci = pt.content_items;\n  const va = pt.video_assets;\n\n  if (ci && ci.platform === 'instagram_reel' && ci.script_json) {\n    if (ci.script_json.hook) { (hookGroups[ci.script_json.hook] ||= []).push(r.completion_rate_pct || 0); }\n    if (ci.script_json.cta) { (ctaGroups[ci.script_json.cta] ||= []).push(r.ctr_pct || 0); }\n  }\n  if (va && va.duration_seconds != null) {\n    (durationGroups[va.duration_seconds] ||= []).push(r.retention_pct || 0);\n  }\n  if (va && va.wardrobe_variant) {\n    const key = va.wardrobe_variant + ' / ' + (va.background_variant || '');\n    (variantGroups[key] ||= []).push(r.completion_rate_pct || 0);\n  }\n  if (pt.platform) {\n    (platformGroups[pt.platform] ||= []).push(r.views || 0);\n  }\n  if (pt.published_at) {\n    const hour = new Date(pt.published_at).getUTCHours();\n    (hourGroups[hour] ||= []).push(r.views || 0);\n  }\n});\n\nconst dimensions = [\n  { insight_type: 'best_hook', metric_name: 'avg_completion_rate_pct', template_key: 'instagram_reel', data: topGroup(hookGroups) },\n  { insight_type: 'best_cta', metric_name: 'avg_ctr_pct', template_key: 'instagram_reel', data: topGroup(ctaGroups) },\n  { insight_type: 'best_duration', metric_name: 'avg_retention_pct', template_key: 'heygen_video_agent_user', data: topGroup(durationGroups) },\n  { insight_type: 'best_avatar_variant', metric_name: 'avg_completion_rate_pct', template_key: null, data: topGroup(variantGroups) },\n  { insight_type: 'best_platform', metric_name: 'avg_views', template_key: null, data: topGroup(platformGroups) },\n  { insight_type: 'best_posting_hour_utc', metric_name: 'avg_views', template_key: null, data: topGroup(hourGroups) }\n];\n\nreturn dimensions.map(dim => ({ json: dim }));\n"
      },
