    {
      "parameters": {
        "jsCode": "const ctx = $('Flatten Insight Insert').item.json;\nconst rows = $input.all().map(function(i) { return i.json; });\nconst current = rows.length ? rows[0].template_body : null;\nconst currentVersion = rows.length ? rows[0].version : 0;\n\nif (!current) {\n  return [{ json: Object.assign({}, ctx, { skip_rewrite: true }) }];\n}\n\nconst prompt = 'You are improving a content-generation prompt template based on a data-driven insight.\\n\\n' +\n  'CURRENT TEMPLATE (template_key: ' + ctx.template_key + '):\\n' + current + '\\n\\n' +\n  'INSIGHT: ' + ctx.finding + '\\n' +\n  'RECOMMENDED CHANGE: ' + ctx.recommended_change + '\\n\\n' +\n  'Rewrite the template to incorporate this change while preserving its overall structure, placeholders (anything in {{double_braces}}), and intent. Return ONLY the full rewritten template text, no commentary, no markdown fences.';\n\nreturn [{ json: Object.assign({}, ctx, { current_template: current, version: currentVersion, rewrite_prompt: prompt }) }];\n"
      },
