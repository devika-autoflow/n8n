    {
      "parameters": {
        "jsCode": "const courseName = $('When Called (course_name)').item.json.course_name;\nconst slug = courseName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');\nconst rows = $input.all().map(i => i.json);\nconst row = rows[0];\nif (!row || !Array.isArray(row.fields) || row.fields.length === 0) {\n  throw new Error('No research_raw data found for course: ' + courseName + '. Run Research Engine first.');\n}\nreturn [{ json: { course_name: courseName, slug, fields: row.fields } }];\n"
      },
