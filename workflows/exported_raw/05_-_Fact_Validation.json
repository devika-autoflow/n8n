    {
      "parameters": {
        "jsCode": "const src = $('Build Course Slug').item.json;\nconst courseIdRows = $input.first().json;\nconst courseId = Array.isArray(courseIdRows) ? courseIdRows[0].id : courseIdRows.id;\n\nconst factsSummary = src.fields.map(f => `- ${f.field_key}: ${JSON.stringify(f.field_value)}`).join('\\n');\n\nconst prompt = `You are an independent fact-checker verifying claims about the Indian graduation course \"${src.course_name}\" using fresh web search.\n\nBelow are researched claims from a prior AI pass. For EACH field, independently search the web and determine if the claim is accurate, especially for numeric fields (salary, placement percentage). Be skeptical — flag anything you cannot verify or that seems wrong.\n\nCLAIMS TO VERIFY:\n${factsSummary}\n\nReturn ONLY valid JSON in this exact shape (no markdown, no commentary):\n{\n  \"field_results\": [\n    { \"field_key\": \"string, must match one of the claim keys above\", \"verified\": true/false, \"confidence\": 0.0-1.0, \"note\": \"short reason\", \"source_urls\": [\"url1\",\"url2\"] }\n  ]\n}\n\nconfidence should reflect how well your independent search agrees with the claim: 1.0 = fully confirmed by multiple sources, 0.5 = partially/uncertain, 0.0 = contradicted or unverifiable.`;\n\nreturn [{ json: { course_name: src.course_name, course_id: courseId, fields: src.fields, prompt } }];\n"
      },
      "id": "w5n-buildverifyprompt",
      "name": "Build Verification Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -48
      ],
      "retryOnFail": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.output;\nif (!raw) {\n  return [{ json: { error: true, message: 'AI Agent verification returned no output' } }];\n}\nconst cleaned = String(raw).replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { error: true, message: 'Failed to parse AI Agent verification output: ' + e.message } }];\n}\nreturn [{ json: parsed }];\n"
      },
      "id": "w5n-mergeverify",
      "name": "Merge Verification Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        -48
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const src = $('Build Verification Prompt').item.json;\nconst resp = $input.first().json;\n\nif (resp.error) {\n  throw new Error(resp.message);\n}\n\nconst results = resp.field_results || [];\nconst resultByKey = {};\nresults.forEach(function(r) { resultByKey[r.field_key] = r; });\n\nconst facts = {};\nconst flaggedFields = [];\nlet confidenceSum = 0;\nlet confidenceCount = 0;\n\nsrc.fields.forEach(function(f) {\n  const r = resultByKey[f.field_key] || { confidence: 0.5, verified: false, source_urls: [] };\n  const confidence = typeof r.confidence === 'number' ? r.confidence : 0.5;\n  const reviewStatus = confidence >= 0.8 ? 'verified' : (confidence >= 0.5 ? 'pending' : 'flagged');\n\n  facts[f.field_key] = {\n    value: f.field_value,\n    confidence_score: confidence,\n    review_status: reviewStatus,\n    source_urls: r.source_urls || [],\n    note: r.note || null\n  };\n\n  confidenceSum += confidence;\n  confidenceCount += 1;\n\n  if (confidence < 0.8) {\n    flaggedFields.push({ field_key: f.field_key, value: f.field_value, confidence_score: confidence });\n  }\n});\n\nconst overallConfidence = confidenceCount ? Math.round((confidenceSum / confidenceCount) * 100) / 100 : 0;\n\nreturn [{ json: {\n  course_name: src.course_name,\n  course_id: src.course_id,\n  facts: facts,\n  overall_confidence: overallConfidence,\n  flagged_fields: flaggedFields\n} }];\n"
      },
