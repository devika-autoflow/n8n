    {
      "parameters": {
        "jsCode": "const items = $input.all().map(function(i) { return i.json; });\nconst resp = items[0];\n\nfunction extractText(resp) {\n  const candidate = (resp.candidates && resp.candidates[0]) || null;\n  if (!candidate) return '';\n  const parts = (candidate.content && candidate.content.parts) || [];\n  const texts = parts.map(function(p) { return p.text || ''; }).filter(Boolean);\n  if (!texts.length) return '';\n  const last = texts[texts.length - 1];\n  const firstBrace = last.indexOf('{');\n  const lastBrace = last.lastIndexOf('}');\n  if (firstBrace !== -1 && lastBrace !== -1 && lastBrace > firstBrace) {\n    return last.slice(firstBrace, lastBrace + 1);\n  }\n  const joined = texts.join('\\n');\n  const fb = joined.indexOf('{');\n  const lb = joined.lastIndexOf('}');\n  if (fb !== -1 && lb !== -1 && lb > fb) return joined.slice(fb, lb + 1);\n  return last;\n}\n\nconst text = extractText(resp);\nreturn [{ json: { output: text } }];\n"
      },
