    {
      "parameters": {
        "jsCode": "const target = $('Loop Publish Targets').item.json;\nconst body = $json;\nconst platform = target.platform;\n\nfunction fromInstagram() {\n  const d = {};\n  (body.data || []).forEach(m => { d[m.name] = m.values?.[0]?.value || 0; });\n  return { views: d.views || d.impressions || 0, reach: d.reach || 0, likes: d.likes || 0, comments: d.comments || 0, shares: d.shares || 0, saves: d.saved || 0, watch_time_seconds: 0, retention_pct: 0, new_subscribers: 0, new_followers: 0, ctr_pct: 0, completion_rate_pct: 0 };\n}\nfunction fromFacebookVideo() {\n  const d = {};\n  (body.data || []).forEach(m => { d[m.name] = m.values?.[0]?.value || 0; });\n  return { views: d.total_video_views || 0, reach: d.total_video_impressions || 0, likes: 0, comments: 0, shares: 0, saves: 0, watch_time_seconds: 0, retention_pct: 0, new_subscribers: 0, new_followers: 0, ctr_pct: 0, completion_rate_pct: 0 };\n}\nfunction fromYoutube() {\n  const row = body.rows?.[0] || [];\n  return { views: row[0]||0, watch_time_seconds: (row[1]||0)*60, retention_pct: row[2]||0, likes: row[3]||0, comments: row[4]||0, shares: row[5]||0, new_subscribers: row[6]||0, reach: 0, saves: 0, new_followers: 0, ctr_pct: 0, completion_rate_pct: row[2]||0 };\n}\nfunction fromLinkedin() {\n  const el = body.elements?.[0]?.totalShareStatistics || {};\n  return { views: el.impressionCount||0, likes: el.likeCount||0, comments: el.commentCount||0, shares: el.shareCount||0, ctr_pct: el.clickCount && el.impressionCount ? (el.clickCount/el.impressionCount*100) : 0, reach: 0, saves: 0, watch_time_seconds: 0, retention_pct: 0, new_subscribers: 0, new_followers: 0, completion_rate_pct: 0 };\n}\n\nlet metrics = {};\nif (platform === 'instagram_reel') metrics = fromInstagram();\nelse if (platform === 'facebook_post') metrics = fromFacebookVideo();\nelse if (platform === 'youtube_shorts') metrics = fromYoutube();\nelse if (platform === 'linkedin_post') metrics = fromLinkedin();\n\nreturn [{ json: { publish_target_id: target.id, ...metrics, raw_payload: body } }];\n"
      },
