    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(function(i) { return i.json; });\nconst byPlatform = {};\nrows.forEach(function(r) {\n  const platform = (r.publish_targets && r.publish_targets.platform) || 'unknown';\n  if (!byPlatform[platform]) byPlatform[platform] = { platform: platform, total_views: 0, total_likes: 0, total_comments: 0, total_shares: 0, completion_sum: 0, completion_count: 0 };\n  const p = byPlatform[platform];\n  p.total_views += r.views || 0;\n  p.total_likes += r.likes || 0;\n  p.total_comments += r.comments || 0;\n  p.total_shares += r.shares || 0;\n  if (typeof r.completion_rate_pct === 'number') { p.completion_sum += r.completion_rate_pct; p.completion_count += 1; }\n});\n\nconst summary = Object.values(byPlatform).map(function(p) {\n  return {\n    platform: p.platform,\n    total_views: p.total_views,\n    total_likes: p.total_likes,\n    total_comments: p.total_comments,\n    total_shares: p.total_shares,\n    avg_completion: p.completion_count ? Math.round((p.completion_sum / p.completion_count) * 100) / 100 : 0\n  };\n}).sort(function(a, b) { return b.total_views - a.total_views; });\n\nreturn summary.map(function(s) { return { json: s }; });\n"
      },
