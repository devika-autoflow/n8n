    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = String(raw || '').replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {};\n  if (/^generate this/i.test(cleaned)) {\n    parsed.video_prompt = cleaned;\n  } else {\n    parsed._raw_unparsed = cleaned;\n  }\n}\n\nconst ctx = $('Build Agent User Message').first().json;\n\n['video_prompt', 'youtube_thumbnail_prompt'].forEach(function(f) {\n  if (typeof parsed[f] === 'string') parsed[f] = parsed[f].replace(/[\\u2014\\u2013]/g, ', ');\n});\n\nif (!parsed.video_prompt || parsed.video_prompt.length < 200) {\n  parsed.video_prompt = 'Generate this in a single pass with one continuous take per scene. Do not create multiple alternate versions of the whole video. Format the output as a 9:16 vertical video suitable for Instagram Reels and YouTube Shorts. The presenter should remain warm and composed, speaking clear Indian English at a comfortable pace, with natural but not excessive hand gestures. To start, ' + ctx.course_name + ' offers strong outcomes: average salary Rs ' + ctx.average_salary + ' per year with placement rate ' + ctx.placement_percent + '%. Many students are unsure if this course is worth pursuing. This course opens paths into ' + ctx.career_path + '. Top recruiters include ' + ctx.recruiters_top5 + '. To close, aspiring students should prepare for ' + ctx.entrance_exams + ' and follow this channel for the next course guide. After the presenter finishes speaking, cut to a final closing scene of 4 to 5 seconds on a clean white background showing the Sugg logo centered above the attached QR code, with the QR code fully visible below it. Keep both the logo and QR code fully visible and completely static for the entire closing scene. Do not fade, redraw, crop, distort, animate, or replace the logo or QR code at any point. Aim for a total video length close to 50 seconds, not exceeding 50 seconds. This is the final creative direction for this single video.';\n}\n\nif (!parsed.youtube_thumbnail_prompt) {\n  parsed.youtube_thumbnail_prompt = 'A confident Indian professional in formal attire stands in a bright modern setting relevant to a career in ' + ctx.course_name + ', looking directly at the camera with a warm, trustworthy expression. Clean corporate background, 16:9 composition, professional photography style, sharp focus, no text or logos in the image.';\n}\n\nfunction wc(s) { return String(s || '').trim().split(/\\s+/).filter(Boolean).length; }\n\nconst reel = parsed.instagram_reel || {};\nconst reelOrder = ['hook', 'problem', 'opportunity', 'evidence', 'cta'];\nlet reelWords = [];\nreelOrder.forEach(function(k) { reelWords = reelWords.concat(String(reel[k] || '').split(/\\s+/).filter(Boolean)); });\nif (reelWords.length > 90) { reelWords = reelWords.slice(0, 90); }\nconst reelBody = reelWords.join(' ');\n\nconst yt = parsed.youtube_shorts || {};\nconst li = parsed.linkedin_post || {};\nconst fb = parsed.facebook_post || {};\n\nconst contentRows = [\n  { course_id: ctx.course_id, platform: 'instagram_reel', title: null, body: reelBody, hashtags: [], metadata: {}, script_json: reel, status: 'draft', word_count: wc(reelBody) },\n  { course_id: ctx.course_id, platform: 'youtube_shorts', title: yt.title || null, body: yt.body || '', hashtags: [], metadata: {}, script_json: null, status: 'draft', word_count: wc(yt.body) },\n  { course_id: ctx.course_id, platform: 'linkedin_post', title: null, body: li.body || '', hashtags: li.hashtags || [], metadata: {}, script_json: null, status: 'draft', word_count: wc(li.body) },\n  { course_id: ctx.course_id, platform: 'facebook_post', title: null, body: fb.body || '', hashtags: fb.hashtags || [], metadata: {}, script_json: null, status: 'draft', word_count: wc(fb.body) }\n];\n\nreturn [{\n  json: {\n    course_id: ctx.course_id,\n    course_name: ctx.course_name,\n    video_prompt: parsed.video_prompt,\n    youtube_thumbnail_prompt: parsed.youtube_thumbnail_prompt,\n    content_rows: contentRows\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
