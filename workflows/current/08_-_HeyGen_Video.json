      "parameters": {
        "jsCode": "const course = $input.first().json;\n\nif (!course.id) {\n  throw new Error(\n    'Verified course not found for id: ' +\n    $('When Executed by Another Workflow').item.json.course_id\n  );\n}\n\nconst salary = course.salaries || {};\n\nconst govColleges = (course.colleges || [])\n  .filter(c => c.type === 'government')\n  .slice(0, 3)\n  .map(c => c.name);\n\nconst privColleges = (course.colleges || [])\n  .filter(c => c.type === 'private')\n  .slice(0, 3)\n  .map(c => c.name);\n\nconst recruiters = (course.careers || [])\n  .slice(0, 5)\n  .map(c => c.role);\n\nconst faqTop2 = (course.faq || [])\n  .slice(0, 2)\n  .map(f => f.question + ' -> ' + f.answer)\n  .join(' | ');\n\nconst latestNews = (course.news || [])\n  .slice()\n  .sort((a, b) => new Date(b.published_at || 0) - new Date(a.published_at || 0))[0];\n\nreturn [{\n  json: {\n    course_id: course.id,\n    course_name: course.name,\n    description: course.description,\n    eligibility: course.eligibility,\n    duration: course.duration,\n    entrance_exams: (course.entrance_exams || []).join(', '),\n    career_path: course.career_path,\n    future_scope: course.future_scope,\n    emerging_trends: course.emerging_trends,\n    abroad_opportunities: course.abroad_opportunities,\n    scholarships: course.scholarships,\n    industry_demand: course.industry_demand,\n    average_salary: salary.average_salary || 'N/A',\n    highest_salary: salary.highest_salary || 'N/A',\n    placement_percent: salary.placement_percent || 'N/A',\n    government_colleges_top3: govColleges.join(', '),\n    private_colleges_top3: privColleges.join(', '),\n    recruiters_top5: recruiters.join(', '),\n    faq_summary: faqTop2,\n    latest_news_summary: latestNews ? (latestNews.headline + ' - ' + latestNews.summary) : ''\n  }\n}];"
      },
