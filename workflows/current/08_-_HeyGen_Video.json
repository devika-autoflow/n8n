    {
      "parameters": {
        "jsCode": "const c = $('Flatten Course').item.json;\nconst NL = String.fromCharCode(10);\nconst lines = [\n  'COURSE: ' + c.course_name,\n  'Description: ' + c.description,\n  'Eligibility: ' + c.eligibility,\n  'Duration: ' + c.duration,\n  'Entrance exams: ' + c.entrance_exams,\n  'Average salary: Rs ' + c.average_salary + ' per year',\n  'Highest salary: Rs ' + c.highest_salary + ' per year',\n  'Placement rate: ' + c.placement_percent + '%',\n  'Top recruiters: ' + c.recruiters_top5,\n  'Career paths: ' + c.career_path,\n  'Top government colleges: ' + c.government_colleges_top3,\n  'Top private colleges: ' + c.private_colleges_top3,\n  'Industry demand: ' + c.industry_demand,\n  'Future scope: ' + c.future_scope,\n  'Emerging trends: ' + c.emerging_trends,\n  'Abroad opportunities: ' + c.abroad_opportunities,\n  'Scholarships available: ' + c.scholarships,\n  'FAQ context: ' + c.faq_summary,\n  'Latest news context: ' + c.latest_news_summary\n];\nreturn [{ json: Object.assign({}, c, { user_message: lines.join(NL) }) }];"
      },
