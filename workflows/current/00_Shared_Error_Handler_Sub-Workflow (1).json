    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst msg = (item.errorMessage || '').toLowerCase();\nlet category = 'unknown';\nif (msg.includes('rate limit') || msg.includes('429')) category = 'rate_limit';\nelse if (msg.includes('timeout') || msg.includes('econnaborted')) category = 'timeout';\nelse if (msg.includes('5') && msg.match(/5\\d\\d/)) category = 'server_error';\nelse if (msg.includes('401') || msg.includes('403')) category = 'auth';\nelse if (msg.includes('validation') || msg.includes('400')) category = 'validation';\n\nconst retryable = ['rate_limit','timeout','server_error'].includes(category);\nconst maxRetries = category === 'rate_limit' ? 3 : 2;\n\nreturn [{ json: { ...item, errorCategory: category, retryable, maxRetries } }];"
      },
